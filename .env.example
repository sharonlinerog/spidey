# Copia este archivo como .env y reemplaza los valores con los de tu proyecto de Supabase.
# Los encuentras en: Supabase -> tu proyecto -> Project Settings -> API
#
# Estas variables son PÚBLICAS: viajan al navegador y eso está bien.
# La seguridad real la dan las políticas RLS del archivo supabase/schema.sql.
# NUNCA pongas aquí la "service_role key" ni la llave VAPID privada.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.reemplaza-esto

# Opcional: recordatorios push de vencimientos.
# Genera el par de llaves con `npm run vapid`. Aquí va SOLO la pública;
# la privada se guarda en los secretos de Supabase.
# Si la dejas vacía, la app funciona igual pero sin recordatorios.
VITE_VAPID_PUBLIC_KEY=
